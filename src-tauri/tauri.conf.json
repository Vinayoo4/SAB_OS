{
  "$schema": "https://schema.tauri.app/2.0.0/tauri.schema.json",
  "productName": "sab-os",
  "version": "0.1.0",
  "identifier": "com.saltedhash.sab-os",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAB-OS Agentic Control Plane",
        "width": 1024,
        "height": 768
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
